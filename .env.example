# ╔══════════════════════════════════════════════════════════════╗
# ║  Salin file ini menjadi .env, lalu isi semua nilai di bawah ║
# ║  cp .env.example .env                                        ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Aplikasi ──────────────────────────────────────────────────
APP_NAME="Manajemen Aset"
APP_ENV=production
APP_KEY=                        # Wajib: php artisan key:generate --show
APP_DEBUG=false                 # Jangan ubah ke true di production
APP_URL=http://IP_ATAU_DOMAIN   # Contoh: http://192.168.1.100:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (MySQL) ──────────────────────────────────────────
# DB_HOST=127.0.0.1 karena diakses via cloudflared tunnel di dalam container
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=management-aset
DB_USERNAME=                    # Wajib: username MySQL
DB_PASSWORD=                    # Wajib: password MySQL

# ── Cloudflare Zero Trust Tunnel (akses DB on-premise) ────────
# Minta nilai CF_ACCESS_* ke tim infrastruktur
CF_ACCESS_HOSTNAME=             # Contoh: db.namadomain.com
CF_ACCESS_CLIENT_ID=            # Wajib: dari Cloudflare Zero Trust > Service Tokens
CF_ACCESS_CLIENT_SECRET=        # Wajib: dari Cloudflare Zero Trust > Service Tokens

# ── Docker Registry (hanya jika deploy pakai image ghcr.io) ───
GITHUB_USER=                    # Username GitHub pemilik image

# ── Port aplikasi ─────────────────────────────────────────────
APP_PORT=8000                   # Port yang dibuka di server (akses: http://IP:8000)

# ── Session, Queue, Cache ─────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Mail (opsional, default: tidak kirim email) ───────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
